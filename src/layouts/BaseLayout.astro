---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Bilgi, araştırma ve merakın izinde.' } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171512" />
    <title>{title} | Süleyman Ay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Courgette&display=swap" rel="stylesheet" />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <style is:global>
      :root {
        --bg: #f4f1e9;
        --surface: #fbfaf6;
        --surface-2: #ebe6da;
        --text: #1b1916;
        --muted: #706b62;
        --accent: #a56d25;
        --accent-strong: #7d4f18;
        --border: #d8d0c1;
        --shadow: 0 24px 70px rgba(45, 36, 24, .10);
        --radius: 18px;
        --max: 1180px;
        --font: 'Courgette', cursive;
      }
      [data-theme='dark'] {
        --bg: #141210;
        --surface: #1b1815;
        --surface-2: #24201b;
        --text: #eee6d8;
        --muted: #b2a99b;
        --accent: #d2a15c;
        --accent-strong: #e0b876;
        --border: #342c23;
        --shadow: 0 24px 70px rgba(0, 0, 0, .28);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font);
        line-height: 1.75;
        transition: background .3s ease, color .3s ease;
      }
      a { color: inherit; }
      button, input { font: inherit; }
      main { width: min(var(--max), calc(100% - 40px)); margin: 0 auto; padding: 64px 0 20px; }
      .site-header {
        position: fixed; inset: 0 0 auto; z-index: 1000;
        width: 100%; background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(16px); border-bottom: 1px solid transparent;
      }
      .header-inner {
        width: min(100% - 48px, 1380px); min-height: 82px; margin: auto;
        display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px;
      }
      .site-brand { justify-self: start; font-size: 1.55rem; text-decoration: none; }
      .desktop-nav { display: flex; gap: 28px; justify-content: center; }
      .desktop-nav a, .header-action { text-decoration: none; color: var(--text); transition: color .2s ease, opacity .2s ease; }
      .desktop-nav a:hover, .header-action:hover { color: var(--accent); }
      .header-actions { justify-self: end; display: flex; gap: 18px; align-items: center; }
      .header-action { display: inline-flex; align-items: center; gap: 6px; border: 0; background: none; padding: 0; cursor: pointer; }
      .header-action svg, .mobile-menu-toggle svg { width: 18px; height: 18px; stroke-width: 1.7; }
      .mobile-menu-toggle { display: none; border: 0; background: none; color: var(--text); padding: 0; cursor: pointer; }
      .mobile-menu { width: min(100% - 32px, 520px); margin: 0 auto 14px; padding: 18px; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); }
      .mobile-menu a { display: block; padding: 10px 6px; text-decoration: none; border-bottom: 1px solid var(--border); }
      .mobile-menu a:last-child { border-bottom: 0; }
      .site-footer { width: min(var(--max), calc(100% - 40px)); margin: 70px auto 0; padding: 28px 0 44px; border-top: 1px solid var(--border); color: var(--muted); }
      .footer-inner { display: flex; justify-content: space-between; gap: 20px; font-size: .85rem; }
      .eyebrow { color: var(--accent); letter-spacing: .08em; font-size: .78rem; }
      .section-title { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: 0; }
      .section-head { display: flex; align-items: center; gap: 18px; margin-bottom: 26px; }
      .section-head::after { content: ''; height: 1px; flex: 1; background: var(--border); }
      .empty-state { padding: 40px; border: 1px dashed var(--border); border-radius: var(--radius); text-align: center; color: var(--muted); background: var(--surface); }
      @media (max-width: 820px) {
        .header-inner { width: calc(100% - 32px); grid-template-columns: 1fr auto; min-height: 70px; }
        .desktop-nav { display: none; }
        .action-label { display: none; }
        .mobile-menu-toggle { display: inline-flex; }
        .header-actions { gap: 14px; }
        .header-actions > .header-action:nth-child(2) { display: none; }
        main { width: min(100% - 28px, var(--max)); padding-top: 42px; }
        .footer-inner { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) window.lucide.createIcons();
        const toggle = document.getElementById('themeToggle');
        const menuToggle = document.getElementById('mobileMenuToggle');
        const mobileMenu = document.getElementById('mobileMenu');
        toggle?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        });
        menuToggle?.addEventListener('click', () => {
          const open = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!open));
          menuToggle.setAttribute('aria-label', open ? 'Menüyü aç' : 'Menüyü kapat');
          mobileMenu.hidden = open;
          if (window.lucide) window.lucide.createIcons();
        });
        mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
          mobileMenu.hidden = true;
          menuToggle?.setAttribute('aria-expanded', 'false');
        }));
        if (window.gsap) {
          let lastY = window.scrollY;
          window.addEventListener('scroll', () => {
            const y = window.scrollY;
            if (y > lastY && y > 90) gsap.to('#main-header', { yPercent: -100, duration: .35, ease: 'power2.out' });
            if (y < lastY) gsap.to('#main-header', { yPercent: 0, duration: .4, ease: 'power2.out' });
            lastY = y;
          }, { passive: true });
          gsap.from('#main-header', { y: -20, opacity: 0, duration: .7, ease: 'power3.out' });
        }
      });
    </script>
  </body>
</html>
