---
import BaseLayout from '../layouts/BaseLayout.astro';
const modules = import.meta.glob('../content/blog/*.md', { eager: true });
const posts = Object.values(modules).map((post:any)=>({id:post.file.split('/').pop().replace('.md',''),title:post.frontmatter.title,description:post.frontmatter.description,category:post.frontmatter.category,date:post.frontmatter.date,tags:post.frontmatter.tags||[],url:post.url,content:post.rawContent||''}));
---
<BaseLayout title="Arama">
  <section class="search-hero"><span class="eyebrow">Arşiv</span><h1>Arama</h1><p>Başlık, kategori, etiket ve yazı içeriğinde ara.</p><input id="searchInput" type="search" placeholder="Aramak istediğinizi yazın..." autofocus /></section>
  <section><div id="suggestions" class="suggestions"></div><p id="resultCount" class="result-count"></p><div id="results" class="results"></div></section>
  <script is:inline define:vars={{ posts }}>
    document.addEventListener('DOMContentLoaded',()=>{
      const input=document.getElementById('searchInput'), results=document.getElementById('results'), count=document.getElementById('resultCount'), suggestions=document.getElementById('suggestions');
      const norm=s=>s.toLocaleLowerCase('tr-TR').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
      const score=(p,q)=>{const fields=[p.title,p.category,p.description,p.tags.join(' '),p.content]; return fields.reduce((n,f)=>n+(norm(f).includes(q)?1:0),0)};
      const highlight=(text,q)=>q?text.replace(new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')})`,'ig'),'<mark>$1</mark>'):text;
      const render=()=>{const q=norm(input.value.trim()); if(!q){results.innerHTML='';suggestions.innerHTML='';count.textContent='';return;} const ranked=posts.map(p=>({...p,s:score(p,q)})).filter(p=>p.s).sort((a,b)=>b.s-a.s||new Date(b.date).getTime()-new Date(a.date).getTime()); count.textContent=`${ranked.length} sonuç`; suggestions.innerHTML=ranked.slice(0,5).map(p=>`<a href="${p.url}">${highlight(p.title,q)}</a>`).join(''); results.innerHTML=ranked.map(p=>`<article class="result-card"><span class="eyebrow">${p.category}</span><h2><a href="${p.url}">${highlight(p.title,q)}</a></h2><p>${highlight(p.description,q)}</p><time>${p.date}</time></article>`).join('');};
      input.addEventListener('input',render); input.addEventListener('keydown',e=>{if(e.key==='Enter'){const q=input.value.trim(); if(q) history.replaceState({},'',`/arama?q=${encodeURIComponent(q)}`); render();}});
      const q=new URLSearchParams(location.search).get('q'); if(q){input.value=q;render();}
    });
  </script>
  <style>.search-hero{padding:60px 0 36px}.search-hero h1{font-size:clamp(3rem,7vw,6rem);margin:10px 0}.search-hero p{color:var(--muted)}#searchInput{width:100%;max-width:760px;padding:17px 20px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--text);outline:none}.suggestions{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.suggestions a{padding:8px 12px;border:1px solid var(--border);border-radius:999px;text-decoration:none;background:var(--surface)}.result-count{color:var(--muted)}.results{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.result-card{padding:24px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);min-height:250px}.result-card h2{line-height:1.3}.result-card h2 a{text-decoration:none}.result-card p{color:var(--muted)}mark{background:color-mix(in srgb,var(--accent) 25%,transparent);color:inherit;border-radius:4px;padding:0 2px}@media(max-width:800px){.results{grid-template-columns:1fr 1fr}}@media(max-width:560px){.results{grid-template-columns:1fr}}</style>
</BaseLayout>
