---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Hakkımda">
  <section class="about"><span class="eyebrow">Hakkımda</span><h1>Süleyman Ay</h1><p class="notice">Bu bölüm, Süleyman Ay tarafından sağlanacak gerçek bilgilerle doldurulacaktır.</p></section>
  <style>.about{padding:80px 0;max-width:820px}.about h1{font-size:clamp(3rem,7vw,6rem);margin:10px 0 30px}.notice{padding:26px;background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius);color:var(--muted)}</style>
</BaseLayout>
