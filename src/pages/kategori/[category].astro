---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const postsImport = import.meta.glob('../../content/blog/*.md', { eager: true });
  const posts = Object.values(postsImport) as any[];

  // Kategorileri dinamik çıkar
  const categories = [...new Set(posts.map((post) => post.frontmatter.category).filter(Boolean))];

  // İçerik tamamen boşsa build'in patlamaması için varsayılan dinamik rotalar sağla
  if (categories.length === 0) {
    return [
      { params: { category: 'bilim' } },
      { params: { category: 'tarih' } },
      { params: { category: 'biyografi' } }
    ];
  }

  return categories.map((category) => ({
    params: { category: category.toLowerCase() },
  }));
}

const { category } = Astro.params;
---

<BaseLayout title={`Kategori: ${category}`}>
  <div class="category-wrapper" style="padding: 2rem 0;">
    <h2 style="font-family: var(--font-serif); text-transform: capitalize;">Kategori: {category}</h2>
    <div style="padding: 2rem; text-align: center; border: 1px dashed var(--border-color); border-radius: 8px; margin-top: 1.5rem;">
      <p style="color: #777;">Bu kategoride henüz yayınlanmış bir içerik bulunmuyor.</p>
    </div>
  </div>
</BaseLayout>
