---
import BaseLayout from '../layouts/BaseLayout.astro';
const modules=import.meta.glob('../content/blog/*.md',{eager:true});
const posts=Object.values(modules).map((post:any)=>({id:post.file.split('/').pop().replace('.md',''),title:post.frontmatter.title,description:post.frontmatter.description,category:post.frontmatter.category,date:post.frontmatter.date,url:post.url}));
const categories=['Bilim','Tarih','Biyografi','Teknoloji','Felsefe','Kültür / Sanat'];
---
<BaseLayout title="Kaydetme">
  <section class="saved-hero"><span class="eyebrow">Kişisel Kütüphane</span><h1>Kaydedilenler</h1><p>Daha sonra okumak üzere ayırdığın gerçek yazılar.</p></section>
  <div class="toolbar"><div class="filters"><button class="filter active" data-category="Tümü">Tümü</button>{categories.map(c=><button class="filter" data-category={c}>{c}</button>)}</div><input id="savedSearch" type="search" placeholder="Kaydedilenlerde ara..." /></div>
  <div id="savedGrid" class="saved-grid"></div><div id="empty" class="empty-state" hidden>Henüz kaydedilmiş bir yazı bulunmuyor.</div>
  <script is:inline define:vars={{ posts }}>
    document.addEventListener('DOMContentLoaded',()=>{const grid=document.getElementById('savedGrid'),empty=document.getElementById('empty'),search=document.getElementById('savedSearch');const norm=s=>s.toLocaleLowerCase('tr-TR');const render=()=>{const ids=JSON.parse(localStorage.getItem('savedPosts')||'[]');const cat=document.querySelector('.filter.active')?.dataset.category||'Tümü';const q=norm(search.value.trim());const list=posts.filter(p=>ids.includes(p.id)&&(cat==='Tümü'||p.category===cat)&&(!q||norm(`${p.title} ${p.description} ${p.category}`).includes(q)));grid.innerHTML=list.map(p=>`<article class="saved-card"><span class="eyebrow">${p.category}</span><h2><a href="${p.url}">${p.title}</a></h2><p>${p.description}</p><div class="saved-foot"><time>${p.date}</time><button data-remove="${p.id}">Kaldır</button></div></article>`).join('');empty.hidden=list.length>0;grid.hidden=!list.length;grid.querySelectorAll('[data-remove]').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.remove;localStorage.setItem('savedPosts',JSON.stringify(ids.filter(x=>x!==id)));render();}));};document.querySelectorAll('.filter').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));b.classList.add('active');render()}));search.addEventListener('input',render);render();});
  </script>
  <style>.saved-hero{padding:60px 0 36px}.saved-hero h1{font-size:clamp(3rem,7vw,6rem);margin:10px 0}.saved-hero p{color:var(--muted)}.toolbar{display:flex;justify-content:space-between;gap:18px;align-items:center;flex-wrap:wrap;margin-bottom:24px}.filters{display:flex;gap:8px;flex-wrap:wrap}.filter{border:1px solid var(--border);background:transparent;color:var(--text);padding:9px 14px;border-radius:999px;cursor:pointer}.filter.active{background:var(--accent);color:#fff;border-color:var(--accent)}#savedSearch{width:min(360px,100%);padding:12px 16px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--text)}.saved-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.saved-card{padding:24px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);min-height:260px}.saved-card h2 a{text-decoration:none}.saved-card p{color:var(--muted)}.saved-foot{display:flex;justify-content:space-between;color:var(--muted);font-size:.8rem}.saved-foot button{border:0;background:none;color:var(--accent);cursor:pointer;font:inherit}@media(max-width:800px){.saved-grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.saved-grid{grid-template-columns:1fr}}</style>
</BaseLayout>
